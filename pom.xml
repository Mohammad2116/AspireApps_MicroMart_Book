<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>book.companion</groupId>
  <artifactId>modern-java-spring-boot-book</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>domain</module>
    <module>application</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <!-- Patch overrides are backed by the security review and full compatibility suite. -->
    <jackson-bom.version>2.21.8</jackson-bom.version>
    <tomcat.version>10.1.61</tomcat.version>
    <netty.version>4.1.140.Final</netty.version>
    <postgresql.version>42.7.14</postgresql.version>
    <log4j2.version>2.26.1</log4j2.version>
    <opentelemetry.version>1.67.0</opentelemetry.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.outputTimestamp>2026-11-04T00:00:00Z</project.build.outputTimestamp>
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>
  <dependencyManagement><dependencies>
    <dependency><groupId>org.xerial.snappy</groupId><artifactId>snappy-java</artifactId><version>1.1.10.12</version></dependency>
    <dependency><groupId>at.yawk.lz4</groupId><artifactId>lz4-java</artifactId><version>1.11.4</version></dependency>
  </dependencies></dependencyManagement>
  <build>
    <plugins>
      <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.16</version><executions>
      <execution><id>agent</id><goals><goal>prepare-agent</goal></goals><configuration><append>true</append></configuration></execution>
      <execution><id>coverage</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
      </executions></plugin>
      <plugin><groupId>com.diffplug.spotless</groupId><artifactId>spotless-maven-plugin</artifactId><version>3.11.0</version><configuration><java><googleJavaFormat><version>1.24.0</version></googleJavaFormat><removeUnusedImports/></java></configuration></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.9,4)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
 <profile><id>static</id><build><plugins><plugin><groupId>com.github.spotbugs</groupId><artifactId>spotbugs-maven-plugin</artifactId><version>4.10.5.0</version><configuration><effort>Max</effort><threshold>Low</threshold><xmlOutput>true</xmlOutput><plugins><plugin><groupId>com.h3xstream.findsecbugs</groupId><artifactId>findsecbugs-plugin</artifactId><version>1.14.0</version></plugin></plugins></configuration><executions><execution><phase>verify</phase><goals><goal>spotbugs</goal></goals></execution></executions></plugin></plugins></build></profile>
    <profile><id>sbom</id><build><plugins><plugin><groupId>org.cyclonedx</groupId><artifactId>cyclonedx-maven-plugin</artifactId><version>2.9.3</version><configuration><outputDirectory>${project.build.directory}</outputDirectory><outputName>bom</outputName><outputFormat>json</outputFormat><includeBomSerialNumber>false</includeBomSerialNumber></configuration><executions><execution><configuration combine.self="override"><outputDirectory>${project.build.directory}</outputDirectory><outputName>bom</outputName><outputFormat>json</outputFormat><includeBomSerialNumber>false</includeBomSerialNumber></configuration><phase>verify</phase><goals><goal>makeAggregateBom</goal></goals></execution></executions></plugin></plugins></build></profile>
    <profile>
      <id>integration</id>
      <build>
        <plugins><plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><executions><execution><id>coverage-gate</id><phase>verify</phase><goals><goal>check</goal></goals><configuration><rules><rule><element>BUNDLE</element><limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit></limits></rule></rules></configuration></execution></executions></plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
