{
  "title": "Book Companion Operations",
  "uid": "book-companion",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "book-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Outbox pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "book-prometheus"
      },
